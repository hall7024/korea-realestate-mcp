  },
  "files": ["dist", "data/regions.json", "data/SOURCES.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:regions": "tsx scripts/gen-regions.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.31.0"
}
