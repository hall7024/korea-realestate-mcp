{
  "name": "korea-realestate-mcp",
  "version": "0.1.2",
  "description": "국토교통부 실거래가 13종 조회와 시세·전세가율 분석 — MCP 서버, CLI, 라이브러리",
  "keywords": ["mcp", "model-context-protocol", "korea", "real-estate", "실거래가", "전세가율", "data.go.kr", "molit"],
  "license": "MIT",
  "author": "hall7024",
  "repository": { "type": "git", "url": "git+https://github.com/hall7024/korea-realestate-mcp.git" },
  "homepage": "https://github.com/hall7024/korea-realestate-mcp#readme",
  "bugs": "https://github.com/hall7024/korea-realestate-mcp/issues",
  "mcpName": "io.github.hall7024/korea-realestate-mcp",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "korea-realestate-mcp": "dist/cli/main.js" },
  "exports": {
    ".": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" },
